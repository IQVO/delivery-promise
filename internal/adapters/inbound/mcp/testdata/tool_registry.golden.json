        },
        "window": {
          "additionalProperties": false,
          "properties": {
            "earliest": {
              "type": "string"
            },
            "latest": {
              "type": "string"
            },
            "timeZone": {
              "type": "string"
            }
          },
          "required": [
            "earliest",
            "latest"
          ],
          "type": "object"
        },
        "witnessPath": {
          "additionalProperties": false,
          "properties": {
            "deliveryWaveId": {
              "type": "string"
            },
            "legs": {
              "items": {
                "type": "string"
              },
