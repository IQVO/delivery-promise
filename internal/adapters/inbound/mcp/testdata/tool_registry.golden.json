      "readOnlyHint": true
    },
    "description": "Read the current promise policy: policyVersion (v0 is the built-in default when nothing was published), offerTtlMinutes and holdTtlMinutes, packagesPerOrder, capacitySharePercent and the per-tier order deadlines (localTime in the destination region's time zone). Publishing a policy is a REST operation. Read-only; takes no arguments.",
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    },
    "name": "get_current_policy",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "capacitySharePercent": {
          "type": "integer"
        },
        "holdTtlMinutes": {
          "type": "integer"
        },
        "offerTtlMinutes": {
          "type": "integer"
        },
        "orderDeadlines": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "localTime": {
                "type": "string"
              },
              "regionId": {
                "type": "string"
              },
              "tier": {
                "type": "string"
              }
            },
            "required": [
              "tier",
              "localTime"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "packagesPerOrder": {
          "type": "integer"
        },
        "policyVersion": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "policyVersion",
        "version",
        "offerTtlMinutes",
        "holdTtlMinutes",
        "packagesPerOrder",
        "capacitySharePercent",
        "orderDeadlines",
        "publishedAt"
      ],
      "type": "object"
    }
  },
