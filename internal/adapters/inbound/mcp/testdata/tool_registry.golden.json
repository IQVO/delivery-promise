[
  {
    "_meta": {
      "com.warehouse/authority": "L1"
    },
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Estimate the delivery options of up to 50 catalogue items for one destination postal prefix, as a product listing page shows them: per item, in request order, the best option of every requested tier (tier, window start/end with the delivery station's IANA timeZone, basis SCHEDULED, MEASURED or NOMINAL, the optional calibrated confidence from 0 to 1 (absent means unknown, not zero), and orderByAt, the latest instant an order still makes that window) and the constraints of the tiers without one (DESTINATION_NOT_SERVED or ITEM_QUANTITY_NOT_AVAILABLE for the whole item, otherwise DELIVERY_SLA_UNAVAILABLE, NODE_CAPACITY_EXHAUSTED or PAST_ORDER_DEADLINE per tier). Each item is searched like a one-line quote, but nothing is stored: no offer, no event, no hold. An estimate is advisory and never reserves capacity; only a quote on REST backs a promise. An unknown item is a constraint, not an error; a bad prefix, tier, quantity, duplicate item or more than 50 items fails with validation-failed.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "destinationPostalPrefix": {
          "description": "the destination postal prefix (never a full address), e.g. 787",
          "type": "string"
        },
        "items": {
          "description": "the items to estimate, 1 to 50, each catalogItemId once",
          "items": {
            "additionalProperties": false,
            "properties": {
              "catalogItemId": {
                "description": "the catalogue item id, unique within the request, e.g. ci-1001",
                "type": "string"
              },
              "quantity": {
                "description": "the units of the item, 1 to 999",
                "type": "integer"
              }
            },
            "required": [
              "catalogItemId",
              "quantity"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "tiers": {
          "description": "optional subset of SAME_DAY, NEXT_DAY, TWO_DAY, STANDARD; all four when omitted",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        }
      },
      "required": [
        "destinationPostalPrefix",
        "items"
      ],
      "type": "object"
    },
    "name": "estimate_delivery",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "computedAt": {
          "type": "string"
        },
        "destinationPostalPrefix": {
          "type": "string"
        },
        "estimates": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "catalogItemId": {
                "type": "string"
              },
              "constraints": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "tier": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "options": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "basis": {
                      "type": "string"
                    },
                    "confidence": {
                      "type": [
                        "null",
                        "number"
                      ]
                    },
                    "orderByAt": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "tier": {
                      "type": "string"
                    },
                    "window": {
                      "additionalProperties": false,
                      "properties": {
                        "end": {
                          "type": "string"
                        },
                        "start": {
                          "type": "string"
                        },
                        "timeZone": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "start",
                        "end",
                        "timeZone"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "tier",
                    "window",
                    "basis"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "quantity": {
                "type": "integer"
              }
            },
            "required": [
              "catalogItemId",
              "quantity",
              "options",
              "constraints"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        }
      },
      "required": [
        "computedAt",
        "destinationPostalPrefix",
        "estimates"
      ],
      "type": "object"
    }
