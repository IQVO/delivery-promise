          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "groupNo": {
          "type": "integer"
        },
        "lines": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "catalogItemId": {
                "type": "string"
              },
              "ownerRef": {
                "type": "string"
              },
              "quantity": {
                "type": "integer"
              }
            },
            "required": [
              "catalogItemId",
              "quantity"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "offerId": {
          "type": "string"
        },
        "orderByAt": {
