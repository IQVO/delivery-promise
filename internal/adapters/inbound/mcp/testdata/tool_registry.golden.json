    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Read the current promise policy: policyVersion (v0 is the built-in default when nothing was published), offerTtlMinutes and holdTtlMinutes, packagesPerOrder, capacitySharePercent, the measured-transit parameters (transitWindowDays of observations kept, transitServiceLevelPercent quoted against a lane's measured transit, minTransitObservations before a lane beats the timetable), the calibration parameters (targetOnTimeProbabilityPercent the share of promises the buffer aims to keep, minCalibrationObservations before a segment is buffered, calibrationWindowDays of judgements kept, maxCalibrationBufferMinutes the cap of the buffer) and the per-tier order deadlines (localTime in the destination region's time zone). Publishing a policy is a REST operation. Read-only; takes no arguments.",
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    },
    "name": "get_current_policy",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "calibrationWindowDays": {
          "type": "integer"
        },
        "capacitySharePercent": {
          "type": "integer"
        },
        "holdTtlMinutes": {
          "type": "integer"
        },
        "maxCalibrationBufferMinutes": {
          "type": "integer"
        },
        "minCalibrationObservations": {
          "type": "integer"
        },
        "minTransitObservations": {
          "type": "integer"
        },
        "offerTtlMinutes": {
          "type": "integer"
        },
        "orderDeadlines": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "localTime": {
                "type": "string"
              },
              "regionId": {
                "type": "string"
              },
              "tier": {
                "type": "string"
              }
            },
            "required": [
              "tier",
              "localTime"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "packagesPerOrder": {
          "type": "integer"
        },
        "policyVersion": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string"
        },
        "targetOnTimeProbabilityPercent": {
          "type": "integer"
        },
        "transitServiceLevelPercent": {
          "type": "integer"
        },
        "transitWindowDays": {
          "type": "integer"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "policyVersion",
        "version",
        "offerTtlMinutes",
        "holdTtlMinutes",
        "packagesPerOrder",
        "capacitySharePercent",
        "transitWindowDays",
        "transitServiceLevelPercent",
        "minTransitObservations",
        "targetOnTimeProbabilityPercent",
        "minCalibrationObservations",
        "calibrationWindowDays",
        "maxCalibrationBufferMinutes",
        "orderDeadlines",
        "publishedAt"
      ],
      "type": "object"
    }
